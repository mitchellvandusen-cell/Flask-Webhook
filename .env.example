# ============================================================
# Flask / Core
# ============================================================
SESSION_SECRET=your-secret-key-here
YOUR_DOMAIN=https://yourdomain.com

# Token Encryption (Fernet AES-128-CBC + HMAC-SHA256)
# OPTIONAL on Railway — if not set, a key is auto-generated on first deploy
# and persisted to the app_settings DB table. Subsequent deploys reuse it.
# Only set this if you want to use an explicit key override.
# Generate manually: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ============================================================
# Database + Redis
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379

# ============================================================
# GoHighLevel OAuth (Public Marketplace App)
# ============================================================
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret
GHL_BASE_URL=https://services.leadconnectorhq.com

# GoHighLevel Conversation Providers (from Marketplace App > Modules > Conversation Providers)
# Used to sync IGB-sent messages and calls back into GHL conversation threads
GHL_SMS_CONVERSATION_PROVIDER_ID=699c84aef36d66cc10a56e82
GHL_CALL_CONVERSATION_PROVIDER_ID=699c83535fc465bbff87a78d

# GHL Marketplace Webhook Signature Verification
MARKETPLACE_WEBHOOK_SECRET=your-marketplace-webhook-secret

# GoHighLevel OAuth (Private App — fallback only)
# All scopes are now approved on the public marketplace app.
# Only set USE_PRIVATE_APP=true if you need to override with private app credentials.
USE_PRIVATE_APP=false
PRIVATE_APP_CLIENT_ID=your-private-app-client-id
PRIVATE_APP_SECRET_ID=your-private-app-secret

# ============================================================
# AI / xAI Grok
# ============================================================
XAI_API_KEY=your-xai-api-key

# ============================================================
# Twilio (Master Account — white-label, users never see these)
# ============================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# API Key for browser-based calling (Access Tokens)
# Create at: https://console.twilio.com/us1/account/keys-credentials/api-keys
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# ============================================================
# Stripe
# ============================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Subscription plan price IDs
STRIPE_PRICE_ID=price_xxx_individual
STRIPE_AGENCY_STARTER_PRICE_ID=price_xxx_agency_starter
STRIPE_AGENCY_PRO_PRICE_ID=price_xxx_agency_pro

# AI Minutes Marketplace — Stripe price IDs for each package
# Create one-time payment prices in Stripe Dashboard, paste IDs here
AI_MINUTES_PRICE_ID_500=price_xxx_500
AI_MINUTES_PRICE_ID_2000=price_xxx_2000
AI_MINUTES_PRICE_ID_5000=price_xxx_5000
AI_MINUTES_PRICE_ID_10000=price_xxx_10000

# ============================================================
# Google Sheets (subscriber sync)
# ============================================================
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
SUBSCRIBER_SHEET_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv
SUBSCRIBER_SHEET_EDIT_URL=https://docs.google.com/spreadsheets/d/...

# ============================================================
# Google Calendar Integration (optional)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Enable the Google Calendar API at https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# ============================================================
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://yourdomain.com/google-calendar/callback

# ============================================================
# Email (Flask-Mail)
# Required for sub-user onboarding invitations
# ============================================================

# Option 1: Gmail SMTP (Recommended for testing)
# Enable "Less secure app access" or use App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Option 2: SendGrid
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Option 3: Mailgun (also used for API-based sending via send_email_api.py)
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=postmaster@yourdomain.mailgun.org
# MAIL_PASSWORD=your-mailgun-smtp-password
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=yourdomain.com

# ============================================================
# Discord Integration
# ============================================================
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_REDIRECT_URI=https://yourdomain.com/discord/callback

# ============================================================
# Slack Integration (optional)
# ============================================================
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://yourdomain.com/slack/callback

# ============================================================
# Cron / Scheduled Jobs
# ============================================================
CRON_SECRET=your-cron-secret

# ============================================================
# Railway Build Config (not used in app code)
# ============================================================
NIXPACKS_PYTHON_VERSION=3.11
# NO_CACHE=true
