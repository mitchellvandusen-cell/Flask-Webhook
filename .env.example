# Flask Configuration
SESSION_SECRET=your-secret-key-here
YOUR_DOMAIN=https://yourdomain.com

# Token Encryption (Fernet AES-128-CBC + HMAC-SHA256)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, tokens are stored in plaintext (migration mode).
TOKEN_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# GoHighLevel OAuth (Public Marketplace App)
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret

# GoHighLevel OAuth (Private App — fallback only)
# All scopes are now approved on the public marketplace app.
# Only set USE_PRIVATE_APP=true if you need to override with private app credentials.
USE_PRIVATE_APP=false
PRIVATE_APP_CLIENT_ID=your-private-app-client-id
PRIVATE_APP_SECRET_ID=your-private-app-secret

# XAI API
XAI_API_KEY=your-xai-api-key

# Twilio (Master Account — white-label, users never see these)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# API Key for browser-based calling (Access Tokens)
# Create at: https://console.twilio.com/us1/account/keys-credentials/api-keys
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# AI Minutes Marketplace — Stripe price IDs for each package
# Create one-time payment prices in Stripe Dashboard, paste IDs here
AI_MINUTES_PRICE_ID_500=price_xxx_500
AI_MINUTES_PRICE_ID_2000=price_xxx_2000
AI_MINUTES_PRICE_ID_5000=price_xxx_5000
AI_MINUTES_PRICE_ID_10000=price_xxx_10000

# Google Sheets (optional)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}
SUBSCRIBER_SHEET_EDIT_URL=https://docs.google.com/spreadsheets/d/...

# ============================================================
# EMAIL CONFIGURATION (Flask-Mail)
# Required for sub-user onboarding invitations
# ============================================================

# Option 1: Gmail SMTP (Recommended for testing)
# Enable "Less secure app access" or use App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Option 2: SendGrid
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Option 3: AWS SES
# MAIL_SERVER=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-ses-smtp-username
# MAIL_PASSWORD=your-ses-smtp-password
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Option 4: Mailgun
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=postmaster@yourdomain.mailgun.org
# MAIL_PASSWORD=your-mailgun-smtp-password
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# ============================================================
# NOTES:
# - For production, use a transactional email service (SendGrid, SES, Mailgun)
# - Gmail has sending limits (500 emails/day)
# - Ensure YOUR_DOMAIN matches your actual domain for invite links
# - MAIL_DEFAULT_SENDER should be a valid email you own
# ============================================================
